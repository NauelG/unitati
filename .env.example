# Postgres (see compose.yaml)
DATABASE_URL="postgres://unitati:unitati@localhost:5432/unitati"

# Signs session cookies and tokens. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-in-every-installation"

# Public origin of this installation
BETTER_AUTH_URL="http://localhost:5173"

# development, staging or production. Everything but production shows an
# environment badge and exposes /dev/components. Unset: development under
# `vite dev`, production in a build.
APP_ENV="development"

# Where ticket attachments are stored. Keep it outside the release directory,
# or every deploy loses the files.
UPLOADS_DIR="./uploads"

# Outbound mail. Leave SMTP_HOST empty to disable it: answering a ticket still
# works, the requester just is not notified. For local development, run
# `docker compose up -d mailpit` and read the mail at http://localhost:8025.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Unitati <no-reply@localhost>"

# IANA time zone of the organisation. A signed handover document states when it
# was decided in this zone and in UTC.
ORGANISATION_TIME_ZONE="Europe/Madrid"

# Single sign-on through the organisation's OpenID Connect identity provider
# (docs/sso-authentik.md). Set all three or none: with none, sign-in is email
# and password only. The redirect URI to register at the provider is
# ${BETTER_AUTH_URL}/api/auth/sso/callback/oidc and is repeated in
# /settings/platform/authentication.
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
