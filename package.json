{
	"name": "unitati",
	"private": true,
	"version": "0.35.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "npm@11.19.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "(svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide) || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --project server --project component",
		"test": "npm run test:unit -- --run",
		"test:db": "vitest --run --project db",
		"test:db:watch": "vitest --project db",
		"db:start": "docker compose up -d --wait",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "node scripts/seed.mjs",
		"db:studio": "drizzle-kit studio",
		"db:stop": "docker compose down",
		"check:version-bump": "node scripts/check-version-bump.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/martian-mono": "^5.3.0",
		"@fontsource-variable/unbounded": "^5.3.0",
		"@inlang/paraglide-js": "^2.26.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.55.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24",
		"@types/nodemailer": "^8.0.2",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^30.1.2",
		"layerchart": "^2.8.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"sveltekit-superforms": "^3.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"better-auth": {
			"@sveltejs/kit": "$@sveltejs/kit"
		}
	},
	"dependencies": {
		"@number-flow/svelte": "^0.4.2",
		"better-auth": "^1.7.7",
		"drizzle-orm": "^0.45.3",
		"drizzle-zod": "^0.8.3",
		"nodemailer": "^10.0.16",
		"postgres": "^3.4.9",
		"svelte-dnd-action": "^0.9.80",
		"svelte-sonner": "^1.2.1",
		"zod": "^4.6.5"
	}
}
