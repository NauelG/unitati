# Environment for `npm run test:db`. Committed on purpose: database-backed tests
# are only reproducible if every machine and CI agree on where they run.
#
# Vitest resolves its config in mode `test`, so Vite's `loadEnv` reads this file
# after `.env` and `.env.local` and wins over both. It does NOT win over a
# `DATABASE_URL` already exported in the shell — `loadEnv` lets `process.env`
# override the files — which is why the harness refuses any database whose name
# does not end in `_test` before it truncates anything.
DATABASE_URL="postgres://unitati:unitati@localhost:5432/unitati_test"

# Importing `$app/env/private` validates every variable declared in src/env.ts,
# not only the one being read, so the file has to satisfy the whole contract.
# Nothing here signs a real cookie; BETTER_AUTH_URL is omitted because it has a
# default.
BETTER_AUTH_SECRET="test-secret-signs-nothing-real"
